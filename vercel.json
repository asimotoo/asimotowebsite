{
  "version": 2,
  "functions": {
    "api/main.ts": {
      "includeFiles": "server/**,shared/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/diag/db",
      "destination": "/api/diag-db-standalone"
    },
    {
      "source": "/api/diag-test",
      "destination": "/api/diag-test.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/main"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
